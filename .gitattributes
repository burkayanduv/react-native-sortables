# Default: treat text files as text and store with LF in the repo
* text=auto eol=lf

# Keep CRLF where it’s required (override per type)
# -text: don't apply line-ending normalization (upstream's stored blobs are
# already CRLF; the "text" attribute causes index/worktree hash mismatch on macOS)
*.bat   -text
*.cmd   -text

# Never touch binaries
*.png   binary
*.jpg   binary
*.pdf   binary
*.zip   binary
*.exe   binary
